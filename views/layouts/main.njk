{% extends "govuk/template.njk" %}

{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{% set htmlLang = "en" %}
{% set assetPath = "/assets" %}
{% set themeColor = "#c8ff02" %}

{% block pageTitle %}{{ pageTitle | default("Move It") }}{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/styles/application.css?v={{ assetVersion }}">
{% endblock %}

{# Move It is not GOV.UK branded, so do not load GOV.UK identity assets. #}
{% block headIcons %}<link rel="icon" href="/favicon.svg" type="image/svg+xml">{% endblock %}

{% block header %}
  <header class="app-header" role="banner">
    <div class="app-header__container govuk-width-container">
      <a class="app-header__logo-link" href="/" aria-label="Opencast Move It home">
        <img
          class="app-header__logo"
          src="/images/opencast-logo.png"
          width="143"
          height="30"
          alt="Opencast"
        >
      </a>
      <a class="app-header__service-name" href="/">Move It</a>
    </div>
    <div class="app-header__brand-stripe" aria-hidden="true"></div>
  </header>

  {% set accountLinks %}
    <nav class="app-service-account" aria-label="Account">
      {% if currentUser %}
        <span class="app-service-account__name">{{ currentUser.displayName }}</span>
        <form action="/logout" method="post">
          <button class="app-service-account__button" type="submit">Sign out</button>
        </form>
      {% else %}
        <a class="govuk-link app-service-account__link" href="/login">Account</a>
      {% endif %}
    </nav>
  {% endset %}

  {{ govukServiceNavigation({
    classes: "app-service-navigation",
    slots: {
      end: {
        html: accountLinks,
        align: "inline"
      }
    },
    navigation: [
      {
        href: "/",
        text: "Home",
        current: currentSection == "home"
      },
      {
        href: "/convert",
        text: "Submit activity",
        current: currentSection == "convert"
      },
      {
        href: "/conversions",
        text: "Conversion guide",
        current: currentSection == "conversions"
      },
      {
        href: "/scoreboard",
        text: "Monthly scoreboard",
        current: currentSection == "scoreboard"
      },
      {
        href: "/about",
        text: "How it works",
        current: currentSection == "about"
      }
    ]
  }) }}

  <nav class="app-mobile-navigation" aria-label="Primary navigation">
    <a class="app-mobile-navigation__link{% if currentSection == 'home' %} app-mobile-navigation__link--current{% endif %}" href="/"{% if currentSection == 'home' %} aria-current="page"{% endif %}>
      <svg class="app-mobile-navigation__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5v8a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-8Z"/></svg>
      <span>Home</span>
    </a>
    <a class="app-mobile-navigation__link{% if currentSection == 'convert' %} app-mobile-navigation__link--current{% endif %}" href="/convert"{% if currentSection == 'convert' %} aria-current="page"{% endif %}>
      <svg class="app-mobile-navigation__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      <span>Submit</span>
    </a>
    <a class="app-mobile-navigation__link{% if currentSection == 'conversions' %} app-mobile-navigation__link--current{% endif %}" href="/conversions"{% if currentSection == 'conversions' %} aria-current="page"{% endif %}>
      <svg class="app-mobile-navigation__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm3 4h8M8 12h3m3 0h2m-8 4h3m3 0h2"/></svg>
      <span>Guide</span>
    </a>
    <a class="app-mobile-navigation__link{% if currentSection == 'scoreboard' %} app-mobile-navigation__link--current{% endif %}" href="/scoreboard"{% if currentSection == 'scoreboard' %} aria-current="page"{% endif %}>
      <svg class="app-mobile-navigation__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20v-6h4v6H5Zm5 0V9h4v11h-4Zm5 0V4h4v16h-4Z"/></svg>
      <span>Scores</span>
    </a>
    <a class="app-mobile-navigation__link{% if currentSection == 'about' %} app-mobile-navigation__link--current{% endif %}" href="/about"{% if currentSection == 'about' %} aria-current="page"{% endif %}>
      <svg class="app-mobile-navigation__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10v1"/></svg>
      <span>How it works</span>
    </a>
  </nav>
{% endblock %}

{% block footer %}
  <footer class="app-footer">
    <div class="govuk-width-container app-footer__container">
      <p class="govuk-body-s govuk-!-margin-bottom-0 app-footer__brand">
        <span>Move It by</span>
        <a class="app-footer__logo-link" href="/" aria-label="Move It homepage">
          <img
            class="app-footer__logo"
            src="/images/opencast-logo.png"
            width="105"
            height="22"
            alt="Opencast"
          >
        </a>
      </p>
      <p class="govuk-body-s govuk-!-margin-bottom-0 app-footer__admin-link">
        <a class="govuk-link" href="/admin/login">Administrator sign in</a>
      </p>
    </div>
  </footer>
{% endblock %}

{% block bodyEnd %}
  {% if vercelAnalytics %}
    <script>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
  {% endif %}
  <script type="module" src="/assets/javascripts/govuk-frontend.min.js"></script>
  <script type="module">
    import { initAll } from "/assets/javascripts/govuk-frontend.min.js";
    initAll();
  </script>
{% endblock %}
