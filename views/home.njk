{% extends "layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = "Move It - Convert activities to steps" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Move It</h1>
      <p class="govuk-body-l">Take part in our monthly challenge. Submit your exercise activities and take part in the monthly scoreboard.</p>

      {{ govukButton({
        text: "Submit an activity",
        href: "/convert/reset",
        isStartButton: true
      }) }}

      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

      <h2 class="govuk-heading-m">Monthly scoreboard</h2>
      <p class="govuk-body">See participants ranked by their total estimated steps for the current month.</p>
      <p class="govuk-body"><a class="govuk-link" href="/scoreboard">View the monthly scoreboard</a></p>

      <h2 class="govuk-heading-m">Conversion guide</h2>
      <p class="govuk-body">Compare the estimated steps for one hour of each available activity and intensity.</p>
      <p class="govuk-body"><a class="govuk-link" href="/conversions">View conversions</a></p>

      <h2 class="govuk-heading-m">How Move it works</h2>
      <p class="govuk-body">Read what information you will need and how Move It calculates step equivalents.</p>
      <p class="govuk-body"><a class="govuk-link" href="/about">Learn more about Move It</a></p>
    </div>
  </div>
{% endblock %}
