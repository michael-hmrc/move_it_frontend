{% extends "layouts/main.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% set pageTitle = team.name + " - Teams - Move It" %}
{% block beforeContent %}{{ govukBackLink({ href: "/teams", text: "Back" }) }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">Team</span>
      <h1 class="govuk-heading-xl">{{ team.name }}</h1>

      {% if team.members.length %}
        {% set rows = [] %}
        {% for member in team.members %}
          {% set rows = (rows.push([{ text: member.displayName }]), rows) %}
        {% endfor %}
        {{ govukTable({ head: [{ text: "Member" }], rows: rows }) }}
      {% else %}
        <p class="govuk-body">This team does not have any members.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
