{% extends "layouts/main.njk" %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% set pageTitle = monthLabel + " individual scoreboard - Move It" %}
{% block beforeContent %}{{ govukBackLink({ href: "/scoreboard", text: "Back" }) }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <span class="govuk-caption-xl">{{ monthLabel }}</span>
      <h1 class="govuk-heading-xl">Individual monthly scoreboard</h1>

      {{ govukInsetText({
        text: "The scoreboard includes all approved users, uses estimated step equivalents and resets at the beginning of each calendar month."
      }) }}

      {% if entries.length %}
        {% set rows = [] %}
        {% for entry in entries %}
          {% set profileLink %}<a class="govuk-link" href="{{ entry.profileHref }}">{{ entry.displayName }}</a>{% endset %}
          {% set activityCountLink %}
            <a class="govuk-link" href="{{ entry.activitiesHref }}">
              View<span class="govuk-visually-hidden"> activities submitted by {{ entry.displayName }}</span>
            </a>
          {% endset %}
          {% set rows = (rows.push([
            { text: entry.rank, format: "numeric" },
            { html: profileLink },
            { text: entry.totalSteps | string, format: "numeric" },
            { html: activityCountLink, format: "numeric" }
          ]), rows) %}
        {% endfor %}

        <div class="app-table-scroll" role="region" aria-label="Monthly scoreboard" tabindex="0">
          {{ govukTable({
            firstCellIsHeader: false,
            head: [
              { text: "Rank", format: "numeric" },
              { text: "Display name" },
              { text: "Estimated steps", format: "numeric" },
              { text: "Activities", format: "numeric" }
            ],
            rows: rows
          }) }}
        </div>
      {% else %}
        <p class="govuk-body-l">There are no recorded activities this month yet.</p>
      {% endif %}

      {{ govukButton({
        text: "Submit an activity",
        href: "/submit/reset",
        isStartButton: true
      }) }}

    </div>
  </div>
{% endblock %}
