{% extends "layouts/main.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% set pageTitle = ("Error: " if errors else "") + "How intense was the activity? - Move It" %}

{% block beforeContent %}{{ govukBackLink({ href: backHref, text: "Back" }) }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds app-question-page">
      {% if errors %}
        {{ govukErrorSummary({ titleText: "There is a problem", errorList: errors }) }}
      {% endif %}

      {% set intensityItems = [] %}
      {% for intensity in intensities %}
        {% set intensityItems = (intensityItems.push({
          value: intensity,
          text: intensity | capitalize,
          checked: values.intensity == intensity
        }), intensityItems) %}
      {% endfor %}

      <form action="{{ formAction }}" method="post" novalidate>
        {{ govukRadios({
          idPrefix: "intensity",
          name: "intensity",
          fieldset: {
            legend: {
              text: "How intense was your " + (activityName | lower) + "?",
              classes: "govuk-fieldset__legend--xl",
              isPageHeading: true
            }
          },
          errorMessage: { text: errorMessage } if errorMessage,
          items: intensityItems
        }) }}

        {{ govukButton({ text: "Continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}
