{% extends "layouts/main.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% set pageTitle = ("Error: " if errors else "") + "What activity did you do? - Move It" %}

{% block beforeContent %}{{ govukBackLink({ href: "/convert", text: "Back" }) }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds app-question-page">
      {% if errors %}
        {{ govukErrorSummary({ titleText: "There is a problem", errorList: errors }) }}
      {% endif %}

      {% set activityItems = [{ value: "", text: "Choose an activity" }] %}
      {% for activity in activities %}
        {% set activityItems = (activityItems.push({
          value: activity.id,
          text: activity.name,
          selected: values.activity == activity.id
        }), activityItems) %}
      {% endfor %}

      <form action="/convert/activity" method="post" novalidate>
        {{ govukSelect({
          id: "activity",
          name: "activity",
          label: {
            text: "What activity did you do?",
            classes: "govuk-label--xl",
            isPageHeading: true
          },
          errorMessage: { text: errorMessage } if errorMessage,
          items: activityItems
        }) }}

        {{ govukButton({ text: "Continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}
