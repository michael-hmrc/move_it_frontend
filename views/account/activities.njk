{% extends "layouts/main.njk" %}

{% from "govuk/components/table/macro.njk" import govukTable %}

{% set pageTitle = pageHeading + " - Move It" %}

{% block beforeContent %}<a class="govuk-back-link" href="{{ backHref }}">Back</a>{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">{{ pageHeading }}</h1>

      {% if submittedActivities.length %}
        {% set rows = [] %}
        {% for activity in submittedActivities %}
          {% set rows = (rows.push([
            { text: activity.submittedOn },
            { text: activity.activityName },
            { text: activity.intensity | capitalize },
            { text: activity.durationMinutes + " minutes", format: "numeric" },
            { text: activity.estimatedSteps | string, format: "numeric" }
          ]), rows) %}
        {% endfor %}

        <p class="govuk-body">Showing the latest 50 submissions.</p>
        <div class="app-table-scroll" role="region" aria-label="Your submitted activities" tabindex="0">
          {{ govukTable({
            head: [
              { text: "Submitted" },
              { text: "Activity" },
              { text: "Intensity" },
              { text: "Duration", format: "numeric" },
              { text: "Estimated steps", format: "numeric" }
            ],
            rows: rows
          }) }}
        </div>
      {% else %}
        <p class="govuk-body">{{ emptyMessage }}</p>
        {% if showSubmitLink %}
          <p class="govuk-body"><a class="govuk-link" href="/convert/reset">Submit an activity</a></p>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock %}
