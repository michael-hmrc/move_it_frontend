{% extends "layouts/main.njk" %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% block content %}
<div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
  <h1 class="govuk-heading-xl">Invitation created</h1>
  {{ govukInsetText({ html: "Copy this temporary password now. It will not be shown again.<br><strong>" + invitation.temporaryPassword + "</strong>" }) }}
  <p class="govuk-body">Give it directly to {{ invitation.displayName }} through a trusted channel. They must change it on first sign-in.</p>
  <p class="govuk-body"><a class="govuk-link" href="/admin">Invite another member</a></p>
</div></div>
{% endblock %}
