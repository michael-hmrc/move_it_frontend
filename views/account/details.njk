{% extends "layouts/main.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set pageTitle = "Your account - Move It" %}

{% block beforeContent %}<a class="govuk-back-link" href="/">Back</a>{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Your account</h1>

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Display name" },
            value: { text: user.displayName }
          },
          {
            key: { text: "Email address" },
            value: { text: user.email }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">Activity history</h2>
      <p class="govuk-body"><a class="govuk-link" href="/account/activities">View your submitted activities</a></p>

      <h2 class="govuk-heading-m">Account security</h2>
      <p class="govuk-body"><a class="govuk-link" href="/account/change-password">Change your password</a></p>
    </div>
  </div>
{% endblock %}
