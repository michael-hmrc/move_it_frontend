# The service works without Supabase; conversions simply will not be stored.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Only addresses at this domain can be invited to Move It.
AUTH_ALLOWED_EMAIL_DOMAIN=opencastsoftware.com

# Generate with: openssl rand -base64 32. Required to access /admin.
ADMIN_ACCESS_TOKEN=r3hD9ujLGRHMq+xrCWnSEWZEDfBzuctUYWaEjaq5VLk=

# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-value

PORT=3000
